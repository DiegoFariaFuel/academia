# Nome do produto (interface)
VITE_APP_NAME=Solviz

# Supabase → Settings → API (Project URL + anon public key)
# NÃO use sb_secret_ no frontend. NÃO use 127.0.0.1:54321 sem `supabase start`.
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: só se rodar Supabase local com `npx supabase start`
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=eyJ... (anon key do supabase status)
# VITE_SUPABASE_LOCAL_OK=1

# Site público (Google Ads, links legais)
VITE_SITE_URL=https://seu-dominio.com
VITE_GTAG_ID=G-XXXXXXXXXX

